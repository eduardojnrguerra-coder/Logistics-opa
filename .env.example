# Copy this file to .env.local and fill in real values.
# Vars prefixed NEXT_PUBLIC_ are shipped to the browser — never put secrets there.

# --- Business identity (white-label branding) ---
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"
NEXT_PUBLIC_LOGO_URL="/logo.png"
NEXT_PUBLIC_PRIMARY_COLOR="#1d4ed8"
NEXT_PUBLIC_CURRENCY_CODE="ZAR"
NEXT_PUBLIC_LOCALE="en-ZA"

# --- Business contact details ---
BUSINESS_CONTACT_EMAIL="ops@yourbusiness.com"
BUSINESS_CONTACT_PHONE=""
BUSINESS_WHATSAPP_NUMBER=""

# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only — never expose to the browser. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Email (Resend, https://resend.com/api-keys) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Fleet tracking provider ---
# One of: demo | cartrack | netstar | tracker_sa | mix_telematics | ctrack | webfleet | teltonika
TRACKING_PROVIDER="demo"
TRACKING_API_KEY=""
TRACKING_API_SECRET=""

# --- WhatsApp (optional channel) ---
WHATSAPP_ENABLED="false"
# One of: twilio | meta_cloud_api
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""
